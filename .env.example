# Copy this file to .env.local and fill in your own values (Supabase → Project Settings → API Keys).
# Use the PROJECT URL and the ANON / PUBLISHABLE key only. Never the service_role or secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
